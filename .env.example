# Mail
MAIL_HOST=smtp.mail.ru
MAIL_PORT=465
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-app-password
BANK_NOTIFICATION_EMAIL=your-email@example.com

# PostgreSQL / Docker Compose
POSTGRES_DB=bank
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Database connection
DATABASE_URL=jdbc:postgresql://localhost:5433/bank
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bank
DATABASE_USER=postgres
DATABASE_PASS=change-me
DEV_DATABASE_PASS=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_USERNAME=change-me
KAFKA_PASSWORD=change-me
KAFKA_TRUSTSTORE_CERTIFICATE=change-me

# JWT
BANK_JWT_SECRET=your-64-character-hex-secret
BANK_JWT_EXPIRATION_MS=86400000

# CVV encryption
CVV_ENCRYPTION_KEY=your-32-character-hex-key